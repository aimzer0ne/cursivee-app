{
  "name": "cursivee.app — Cursive & Unicode Text Generator",
  "short_name": "cursivee",
  "description": "Turn what you type into script, small, glitch and weird Unicode alphabets you can paste anywhere plain text is allowed.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#E8ECF1",
  "theme_color": "#E8ECF1",
  "categories": ["utilities", "productivity", "social"],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Cursive text",
      "short_name": "Cursive",
      "url": "./index.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Small text",
      "short_name": "Small",
      "url": "./small-text.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Glitch text",
      "short_name": "Glitch",
      "url": "./glitch-text.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Weird text",
      "short_name": "Weird",
      "url": "./weird-text.html",
      "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
